<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="695.0" prefWidth="964.0" style="-fx-background-color: #edfaff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pharmacymanagementsystem.PurchasesController">
   <children>
      <Label layoutX="80.0" layoutY="119.0" prefHeight="35.0" prefWidth="167.0" text="Search Purchase :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="19.0" />
         </font>
      </Label>
      <Button fx:id="btnsearchpur" layoutX="492.0" layoutY="120.0" mnemonicParsing="false" onAction="#handlesearchpurches" styleClass="custom-button" stylesheets="@button.css" text="Search" />
      <Button fx:id="addnewpurchasebtn" layoutX="247.0" layoutY="613.0" mnemonicParsing="false" onAction="#handlenewpurchase" styleClass="custom-button" stylesheets="@button.css" text="+ New Purchase" />
      <Button fx:id="clearbtnsearch" layoutX="613.0" layoutY="120.0" mnemonicParsing="false" onAction="#handleclearsearch" prefHeight="34.0" prefWidth="81.0" styleClass="custom-button" stylesheets="@button.css" text="Clear" />
      <TextField fx:id="txtsearchpurchase" layoutX="247.0" layoutY="124.0" prefHeight="26.0" prefWidth="200.0" />
      <TableView fx:id="tblpurchase" layoutY="241.0" prefHeight="358.0" prefWidth="963.0" stylesheets="@table.css">
        <columns>
          <TableColumn fx:id="colpurshnum" prefWidth="75.0" text="Purchase Numder" />
            <TableColumn fx:id="coldate" prefWidth="75.0" text="Date " />
            <TableColumn fx:id="coltotal" prefWidth="75.0" text="Total " />
            <TableColumn fx:id="colview" prefWidth="75.0" text="View " />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="cleartblbtn" layoutX="595.0" layoutY="613.0" mnemonicParsing="false" onAction="#handleclearpurshase" prefHeight="34.0" prefWidth="144.0" styleClass="custom-button" stylesheets="@button.css" text="Clear" />
      <Label alignment="CENTER" layoutX="2.0" prefHeight="54.0" prefWidth="966.0" style="-fx-background-color: #bbe2f2;" text="Purchase" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="24.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
   </children>
</AnchorPane>
