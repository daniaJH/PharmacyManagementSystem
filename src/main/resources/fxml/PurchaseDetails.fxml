<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #edfaff;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="com.mycompany.pharmacymanagementsystem.PurchaseDetailsController">
   <children>
      <Label alignment="CENTER" layoutX="-1.0" layoutY="-3.0" prefHeight="42.0" prefWidth="600.0" style="-fx-background-color: #bbe2f2;" text="Purchase Details" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="27.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
      <Label layoutX="32.0" layoutY="53.0" prefHeight="20.0" prefWidth="96.0" text="Purchase :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="17.0" />
         </font>
      </Label>
      <Label layoutX="32.0" layoutY="82.0" prefHeight="14.0" prefWidth="55.0" text="Date :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="17.0" />
         </font>
      </Label>
      <Label layoutX="32.0" layoutY="116.0" prefHeight="14.0" prefWidth="55.0" text="Total :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="17.0" />
         </font>
      </Label>
      <TableView fx:id="tblpurcD" layoutX="1.0" layoutY="150.0" prefHeight="250.0" prefWidth="600.0" stylesheets="@table.css">
        <columns>
          <TableColumn fx:id="Batchid" prefWidth="75.0" text="Batch" />
          <TableColumn fx:id="ProductName" prefWidth="75.0" text="Product" />
            <TableColumn fx:id="price" prefWidth="75.0" text="Price" />
            <TableColumn fx:id="quantity" prefWidth="75.0" text="Quantity" />
            <TableColumn fx:id="expiry" prefWidth="75.0" text="Expiry" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label fx:id="purchaseinpurD" layoutX="144.0" layoutY="54.0" text="Label">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="16.0" />
         </font>
      </Label>
      <Label fx:id="dateinpurcD" layoutX="144.0" layoutY="83.0" text="Label">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="16.0" />
         </font>
      </Label>
      <Label fx:id="totalinpurD" layoutX="144.0" layoutY="118.0" text="Label">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="16.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
