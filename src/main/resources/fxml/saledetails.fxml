<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="534.0" prefWidth="474.0" style="-fx-background-color: #edfaff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pharmacymanagementsystem.SaleDetailsController">

    <children>

        <Label alignment="CENTER" layoutX="-9.0" prefHeight="58.0" prefWidth="494.0" style="-fx-background-color: #bbe2f2;" text="Sale Details" textFill="#00218c">

            <effect>
                <DropShadow />
            </effect>

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="28.0" />
            </font>

        </Label>


        <TableView fx:id="saleDetailsTable" layoutX="-2.0" layoutY="111.0" prefHeight="422.0" prefWidth="486.0" stylesheets="@table.css">

            <columns>

                <TableColumn fx:id="invoiceNumberColumn" prefWidth="112.79992830753326" text="Invoice Number" />

                <TableColumn fx:id="batchNumberColumn" prefWidth="99.99999237060547" text="Batch Number" />

                <TableColumn fx:id="quantityColumn" prefWidth="61.5999755859375" text="Quantity" />

                <TableColumn fx:id="sellingPriceColumn" prefWidth="87.20001220703125" text="Selling Price" />

                <TableColumn fx:id="totalColumn" prefWidth="48.0" text="Total" />

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>

        </TableView>

    </children>

</AnchorPane>
