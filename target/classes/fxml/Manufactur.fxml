<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="695.0" prefWidth="926.0" style="-fx-background-color: #edfaff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pharmacymanagementsystem.ManufController">
   <children>
      <Label alignment="CENTER" prefHeight="52.0" prefWidth="966.0" style="-fx-background-color: #bbe2f2;" text="Manufacturing Company" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="24.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
      <TextField fx:id="txtSearchCompany" layoutX="202.0" layoutY="114.0" prefHeight="26.0" prefWidth="453.0" />
      <Button fx:id="btnSearchCompany" layoutX="697.0" layoutY="110.0" mnemonicParsing="false" onAction="#handleSearchCompany" styleClass="custom-button" stylesheets="@button.css" text="Search" />
      <Button fx:id="btnClearCompany" layoutX="816.0" layoutY="108.0" mnemonicParsing="false" onAction="#handleClearSearch" prefHeight="34.0" prefWidth="81.0" styleClass="custom-button" stylesheets="@button.css" text="Clear" />
      <TableView fx:id="companyTable" layoutY="210.0" prefHeight="300.0" prefWidth="966.0" stylesheets="@table.css">
        <columns>
          <TableColumn fx:id="companycolcode" prefWidth="75.0" text="Code " />
          <TableColumn fx:id="companycolname" prefWidth="75.0" text="Company Name" />
            <TableColumn fx:id="companycolphone" prefWidth="75.0" text="Phone " />
            <TableColumn fx:id="companycolcountry" prefWidth="75.0" text="Country " />
            <TableColumn fx:id="companycolcity" prefWidth="75.0" text="City " />
            <TableColumn fx:id="companycolinz" prefWidth="75.0" text="Industrial Zone" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label layoutX="94.0" layoutY="113.0" text="Search :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="21.0" />
         </font>
      </Label>
      <Button fx:id="addbtncompany" layoutX="101.0" layoutY="572.0" mnemonicParsing="false" onAction="#handleAddCompany" styleClass="custom-button" stylesheets="@button.css" text="Add Company" />
      <Button fx:id="updatebtncompany" layoutX="306.0" layoutY="572.0" mnemonicParsing="false" onAction="#handleUpdateCompany" prefHeight="34.0" prefWidth="130.0" styleClass="custom-button" stylesheets="@button.css" text="Update" />
      <Button fx:id="deletebtncompany" layoutX="540.0" layoutY="572.0" mnemonicParsing="false" onAction="#handleDeleteCompany" prefHeight="34.0" prefWidth="130.0" styleClass="custom-button" stylesheets="@button.css" text="Delete" />
      <Button fx:id="clearbtncompany" layoutX="751.0" layoutY="572.0" mnemonicParsing="false" onAction="#handleClearTable" prefHeight="34.0" prefWidth="130.0" styleClass="custom-button" stylesheets="@button.css" text="Clear" />
   </children>
</AnchorPane>
