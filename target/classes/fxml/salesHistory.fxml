<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane
    prefHeight="501.0"
    prefWidth="672.0"
    style="-fx-background-color: #edfaff;"
    xmlns="http://javafx.com/javafx/26"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.mycompany.pharmacymanagementsystem.salesHistoryController">

    <children>

        <Label
            alignment="CENTER"
            layoutY="-1.0"
            prefHeight="44.0"
            prefWidth="674.0"
            style="-fx-background-color: #bbe2f2;"
            text="Sales History"
            textFill="#00218c">

            <font>
                <Font
                    name="Berlin Sans FB Demi Bold"
                    size="27.0"/>
            </font>

            <effect>
                <DropShadow/>
            </effect>
        </Label>

        <Label
            layoutX="32.0"
            layoutY="57.0"
            text="Invoice Number :"
            textFill="#00218c">

            <font>
                <Font
                    name="Berlin Sans FB Demi Bold"
                    size="17.0"/>
            </font>
        </Label>

        <TextField
            fx:id="txtinvoicenum"
            layoutX="33.0"
            layoutY="88.0"
            prefHeight="26.0"
            prefWidth="203.0"/>

        <Button
            fx:id="searchbtninvoicen"
            layoutX="337.0"
            layoutY="83.0"
            mnemonicParsing="false"
            onAction="#handleSearchInvoice"
            styleClass="custom-button"
            stylesheets="@button.css"
            text="Search"/>

        <Button
            fx:id="clearinvoiceser"
            layoutX="449.0"
            layoutY="83.0"
            mnemonicParsing="false"
            onAction="#handleClearSearch"
            prefHeight="34.0"
            prefWidth="80.0"
            styleClass="custom-button"
            stylesheets="@button.css"
            text="Clear"/>

        <TableView
            fx:id="tblsaleshistory"
            layoutX="-2.0"
            layoutY="141.0"
            prefHeight="217.0"
            prefWidth="674.0"
            stylesheets="@table.css">

            <columns>

                <TableColumn
                    fx:id="codeinvoice"
                    prefWidth="75.0"
                    text="Invoice"/>

                <TableColumn
                    fx:id="dateinvoice"
                    prefWidth="75.0"
                    text="Date"/>

                <TableColumn
                    fx:id="cusinvoice"
                    prefWidth="75.0"
                    text="Customer"/>

                <TableColumn
                    fx:id="employeeinvice"
                    prefWidth="75.0"
                    text="Employee"/>

                <TableColumn
                    fx:id="totalinvoice"
                    prefWidth="75.0"
                    text="Total"/>

            </columns>

            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

        </TableView>

        <Button
            fx:id="saledatailsbutton"
            layoutX="135.0"
            layoutY="400.0"
            mnemonicParsing="false"
            onAction="#handleSaleDetails"
            styleClass="custom-button"
            stylesheets="@button.css"
            text="Details"/>

        <Button
            fx:id="cleartblsalesinvoic"
            layoutX="294.0"
            layoutY="400.0"
            mnemonicParsing="false"
            onAction="#handleClearTable"
            prefHeight="34.0"
            prefWidth="81.0"
            styleClass="custom-button"
            stylesheets="@button.css"
            text="Clear"/>

        <Button
            fx:id="deletesale"
            layoutX="449.0"
            layoutY="400.0"
            mnemonicParsing="false"
            onAction="#handleDeleteSale"
            styleClass="custom-button"
            stylesheets="@button.css"
            text="Delete"/>

    </children>

</AnchorPane>
