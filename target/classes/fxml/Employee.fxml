<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="695.0" prefWidth="963.0" style="-fx-background-color: #edfaff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pharmacymanagementsystem.EmployeeController">
   <children>
      <Button fx:id="clearempsearchbtn" layoutX="710.0" layoutY="124.0" mnemonicParsing="false" onAction="#handleClearEmployeeSearch" prefHeight="34.0" prefWidth="86.0" styleClass="custom-button" stylesheets="@button.css" text="Clear" />
      <Button fx:id="searchempbtn" layoutX="580.0" layoutY="123.0" mnemonicParsing="false" onAction="#handleSearchEmployee" prefHeight="34.0" prefWidth="86.0" styleClass="custom-button" stylesheets="@button.css" text="Search" />
      <TextField fx:id="txtsearchemp" layoutX="215.0" layoutY="124.0" prefHeight="34.0" prefWidth="282.0" />
      <Label layoutX="119.0" layoutY="127.0" prefHeight="26.0" prefWidth="86.0" text="Search :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="24.0" />
         </font>
      </Label>
      <TableView fx:id="tblemp" layoutX="1.0" layoutY="190.0" prefHeight="338.0" prefWidth="964.0" stylesheets="@table.css">
        <columns>
          <TableColumn fx:id="Idempcol" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="fnameempcol" prefWidth="75.0" text="First Name" />
            <TableColumn fx:id="lnameempcol" prefWidth="75.0" text="Last Name" />
            <TableColumn fx:id="phoneempcol" prefWidth="75.0" text="Phone" />
            <TableColumn fx:id="cityempcol" prefWidth="75.0" text="City" />
            <TableColumn fx:id="streetcol" prefWidth="75.0" text="Street" />
            <TableColumn fx:id="buildingcol" prefWidth="75.0" text="Building" />
            <TableColumn fx:id="hiredatecol" prefWidth="75.0" text="Hire Date" />
            <TableColumn fx:id="jobempcol" prefWidth="75.0" text="JOB" />
            <TableColumn fx:id="salarycol" prefWidth="75.0" text="Salary" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="addempbtn" layoutX="162.0" layoutY="580.0" mnemonicParsing="false" onAction="#handleAddEmployee" styleClass="custom-button" stylesheets="@button.css" text="Add Employee" />
      <Button fx:id="deleteempbtn" layoutX="513.0" layoutY="580.0" mnemonicParsing="false" onAction="#handleDeleteEmployee" prefHeight="34.0" prefWidth="133.0" styleClass="custom-button" stylesheets="@button.css" text="Delete" />
      <Button fx:id="editempbtn" layoutX="337.0" layoutY="580.0" mnemonicParsing="false" onAction="#handleEditEmployee" prefHeight="34.0" prefWidth="133.0" styleClass="custom-button" stylesheets="@button.css" text="Update" />
      <Button fx:id="cleartblempbtn" layoutX="684.0" layoutY="580.0" mnemonicParsing="false" onAction="#handleClearEmployeeTable" prefHeight="34.0" prefWidth="133.0" styleClass="custom-button" stylesheets="@button.css" text="Clear" />
      <Label alignment="CENTER" prefHeight="54.0" prefWidth="966.0" style="-fx-background-color: #bbe2f2;" text="Employee " textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="24.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
   </children>
</AnchorPane>
