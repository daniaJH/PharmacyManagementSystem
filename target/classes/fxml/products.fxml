<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.Light.Distant?>
<?import javafx.scene.effect.Lighting?>
<?import javafx.scene.effect.Shadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="695.0" prefWidth="970.0" style="-fx-background-color: #edfaff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pharmacymanagementsystem.ProductController">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutY="-3.0" prefHeight="54.0" prefWidth="970.0" style="-fx-background-color: #bbe2f2;" text="Products" textAlignment="CENTER" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="25.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
      <Label layoutX="34.0" layoutY="80.0" text="Product Type :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="18.0" />
         </font>
      </Label>
      <RadioButton fx:id="rbAll" layoutX="65.0" layoutY="114.0" mnemonicParsing="false" selected="true" text="All Products" textFill="#00218c">
         <toggleGroup>
            <ToggleGroup fx:id="producttype" />
         </toggleGroup>
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="12.0" />
         </font>
      </RadioButton>
      <RadioButton fx:id="rbMedicine" layoutX="437.0" layoutY="114.0" mnemonicParsing="false" text="Medicine" textFill="#00218c" toggleGroup="$producttype">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="12.0" />
         </font>
      </RadioButton>
      <RadioButton fx:id="rbCare" layoutX="742.0" layoutY="114.0" mnemonicParsing="false" text="Care Product" textFill="#00218c" toggleGroup="$producttype">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="12.0" />
         </font>
      </RadioButton>
      <Label layoutX="35.0" layoutY="163.0" text="Search :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="searchField" layoutX="116.0" layoutY="161.0" prefHeight="26.0" prefWidth="178.0">
         <effect>
            <Lighting diffuseConstant="1.42">
               <bumpInput>
                  <Shadow />
               </bumpInput>
               <light>
                  <Light.Distant />
               </light>
            </Lighting>
         </effect>
      </TextField>
      <Button fx:id="btnSearch" layoutX="533.0" layoutY="156.0" mnemonicParsing="false" onAction="#handleSearchAction" styleClass="custom-button" stylesheets="@button.css" text="Search">
         <effect>
            <DropShadow />
         </effect>
      </Button>
      <Button fx:id="btnClear" layoutX="707.0" layoutY="157.0" mnemonicParsing="false" onAction="#handleClearSearchAction" prefHeight="34.0" prefWidth="81.0" styleClass="custom-button" stylesheets="@button.css" text="Clear">
         <effect>
            <DropShadow />
         </effect>
      </Button>
      <TableView fx:id="productTable" editable="true" layoutX="11.0" layoutY="213.0" prefHeight="317.0" prefWidth="948.0" stylesheets="@table.css" tableMenuButtonVisible="true">
        <columns>
          <TableColumn fx:id="productCodeColumn" prefWidth="66.39999079704285" text=" Code" />
          <TableColumn fx:id="tradeNameColumn" prefWidth="83.20001220703125" text="T Name" />
            <TableColumn fx:id="unitColumn" prefWidth="45.5999755859375" text="Unit" />
            <TableColumn fx:id="minStockColumn" prefWidth="102.40003967285156" text="Min Stock Level" />
            <TableColumn fx:id="manufacturerColumn" prefWidth="88.800048828125" text=" companies" />
            <TableColumn fx:id="dosageColumn" prefWidth="80.00006103515625" text="Dosage" />
            <TableColumn fx:id="scientificNameColumn" prefWidth="114.39996337890625" text="S Name" />
            <TableColumn fx:id="activeIngredientsColumn" prefWidth="126.4000244140625" text="Active In" />
            <TableColumn fx:id="prescriptionRequiredColumn" prefWidth="54.39996337890625" text="Rx Req" />
            <TableColumn fx:id="productTypeColumn" prefWidth="56.00006103515625" text="Type" />
            <TableColumn fx:id="usageMethodColumn" prefWidth="113.5999755859375" text="Usage Method" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Button fx:id="btnAddProduct" layoutX="91.0" layoutY="587.0" mnemonicParsing="false" onAction="#handleOpenAddProductWindow" styleClass="custom-button" stylesheets="@button.css" text="Add Product" />
      <Button fx:id="btnUpdate" layoutX="317.0" layoutY="587.0" mnemonicParsing="false" onAction="#handleUpdateAction" prefHeight="34.0" prefWidth="120.0" styleClass="custom-button" stylesheets="@button.css" text="Update" />
      <Button fx:id="btnDelete" layoutX="533.0" layoutY="587.0" mnemonicParsing="false" onAction="#handleDeleteAction" prefHeight="34.0" prefWidth="120.0" styleClass="custom-button" stylesheets="@button.css" text="Delete" />
      <Button fx:id="btnClear" layoutX="742.0" layoutY="587.0" mnemonicParsing="false" onAction="#handleClearTableAction" prefHeight="34.0" prefWidth="120.0" styleClass="custom-button" stylesheets="@button.css" text="clear" />
   </children>
</AnchorPane>
