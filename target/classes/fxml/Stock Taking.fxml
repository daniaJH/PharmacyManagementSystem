<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane id="AnchorPane" prefHeight="695.0" prefWidth="963.0" style="-fx-background-color: #edfaff;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.pharmacymanagementsystem.StockTakingController">
   <children>
      <ComboBox fx:id="comboproductselect" layoutX="241.0" layoutY="127.0" prefWidth="150.0" stylesheets="@combo.css">
         <styleClass>
            <String fx:value="combo-box" />
            <String fx:value="combo-box-popup" />
            <String fx:value="list-cell" />
            <String fx:value="list-view" />
         </styleClass>
      </ComboBox>
      <Button fx:id="btncleartbl" layoutX="598.0" layoutY="584.0" mnemonicParsing="false" onAction="#handleclearbtn" prefHeight="34.0" prefWidth="153.0" styleClass="custom-button" stylesheets="@button.css" text="Clear" />
      <TableView fx:id="tblstoktaking" layoutX="-3.0" layoutY="210.0" prefHeight="288.0" prefWidth="963.0" stylesheets="@table.css">
        <columns>
          <TableColumn fx:id="colprocode" editable="false" prefWidth="75.0" text="Product Code" />
          <TableColumn fx:id="colproname" prefWidth="75.0" text="Product Name" />
            <TableColumn fx:id="systemquantity" prefWidth="75.0" text="System Quantity" />
            <TableColumn fx:id="actualquantity" editable="true" prefWidth="75.0" text="Actual Quantity" />
            <TableColumn fx:id="differcol" prefWidth="75.0" text="Different" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      <Label layoutX="92.0" layoutY="73.0" prefHeight="20.0" prefWidth="150.0" text="Stock Taking No :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="17.0" />
         </font>
      </Label>
      <Label fx:id="stocktakingnum" layoutX="250.0" layoutY="73.0" prefHeight="20.0" prefWidth="132.0" text="Label" />
      <Label fx:id="datetoday" layoutX="826.0" layoutY="83.0" prefHeight="20.0" prefWidth="122.0" text="Label" />
      <Label fx:id="totalstockTaking" layoutX="482.0" layoutY="530.0" text="Label" />
      <Button fx:id="searchproduct" layoutX="496.0" layoutY="129.0" mnemonicParsing="false" onAction="#handlesearchpro" styleClass="custom-button" stylesheets="@button.css" text="Search" />
      <Button fx:id="btnsavestck" layoutX="266.0" layoutY="584.0" mnemonicParsing="false" onAction="#handlesavebtn" styleClass="custom-button" stylesheets="@button.css" text="Save StockTaking" />
      <Label layoutX="752.0" layoutY="83.0" text="Date :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="17.0" />
         </font>
      </Label>
      <Label layoutX="95.0" layoutY="136.0" text="Search Product :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="17.0" />
         </font>
      </Label>
      <Label layoutX="419.0" layoutY="529.0" text="Total :" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="17.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="6.0" prefHeight="54.0" prefWidth="966.0" style="-fx-background-color: #bbe2f2;" text="Stock Taking" textFill="#00218c">
         <font>
            <Font name="Berlin Sans FB Demi Bold" size="24.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
      </Label>
   </children>
</AnchorPane>
