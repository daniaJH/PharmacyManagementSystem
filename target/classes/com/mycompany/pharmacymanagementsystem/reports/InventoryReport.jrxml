    <property name="com.jaspersoft.studio.data.defaultdataadapter"
              value="New Data Adapter"/>

    <property name="com.jaspersoft.studio.data.sql.tables"
              value=""/>

    <!-- =========================================================
         SQL QUERY - UNCHANGED
         ========================================================= -->

    <query language="sql"><![CDATA[
SELECT
    p.productcode,
    p.tradename,
    p.unit,
    b.quantity,
    p.price,
    b.expire_date
FROM public.product p
JOIN public.batch b
    ON p.productcode = b.productcode
ORDER BY p.tradename, b.expire_date;
    ]]></query>


